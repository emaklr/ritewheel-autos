# PostgreSQL. Use a pooled connection for runtime and a direct connection for Prisma migrations when your host provides both.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Set a long random value before deploying admin authentication.
AUTH_SECRET="replace-with-a-long-random-secret"

# Google Gemini key; the marketplace remains available when this is not configured.
GOOGLE_GENERATIVE_AI_API_KEY=""

# Public canonical URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
