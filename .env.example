# PostgreSQL. Use a pooled connection for runtime and a direct connection for Prisma migrations when your host provides both.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# DIRECT_URL is optional; Prisma migrations use it when the provider exposes a direct connection.
# Reserved for future signed customer/CSRF tokens. Admin sessions are opaque, database-backed tokens.
AUTH_SECRET=""

# Add one or more server-side provider keys. The Concierge falls back in the configured order.
NVIDIA_API_KEY=""
OPENROUTER_API_KEY=""
GROQ_API_KEY=""

# Optional provider/model selection. Providers omitted from the order are not used.
RITEWHEEL_AI_PROVIDER_ORDER="nvidia,openrouter,groq"
NVIDIA_MODEL="nvidia/nemotron-3.5-super-vl-120b-a12b"
OPENROUTER_MODEL="openrouter/free"
GROQ_MODEL="openai/gpt-oss-120b"

# Public canonical URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
