# PostgreSQL runtime connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Optional direct connection for migration tooling
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Server-side Google Gemini key; marketplace works without it
GOOGLE_GENERATIVE_AI_API_KEY=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Demo listings are used only while DATABASE_URL is absent
DEMO_MODE="true"