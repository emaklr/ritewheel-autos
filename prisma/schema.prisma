generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum VehicleStatus {
  DRAFT
  AVAILABLE
  RESERVED
  SOLD
  ARCHIVED
}

enum EnquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
  SPAM
}

enum TestDriveStatus {
  REQUESTED
  ACCEPTED
  DECLINED
  COMPLETED
  CANCELLED
}

enum SourcingRequestStatus {
  NEW
  REVIEWING
  SOURCING
  MATCH_FOUND
  QUOTED
  CUSTOMER_APPROVED
  FULFILLED
  UNAVAILABLE
  DECLINED
  CANCELLED
  CLOSED
}

enum CustomerAccountStatus {
  ACTIVE
  DISABLED
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("ADMIN")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs AdminAuditLog[]
  sessions  AdminSession[]
}

model AdminSession {
  id         String    @id @default(cuid())
  adminUserId String
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, expiresAt])
  @@index([expiresAt])
}

/// A CRM person record. It can exist without a login account.
model Customer {
  id              String   @id @default(cuid())
  name            String
  email           String?
  /// Trimmed and case-normalized for lookup; deliberately non-unique so duplicate guest records remain reviewable.
  emailNormalized String?
  phone           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  account CustomerAccount?

  @@index([emailNormalized, createdAt])
  @@index([phone])
}

/// A login identity for a Customer. The email field stores the trimmed, case-normalized address.
model CustomerAccount {
  id                String               @id @default(cuid())
  customerId        String               @unique
  email             String               @unique
  passwordHash      String
  emailVerifiedAt   DateTime?
  status            CustomerAccountStatus @default(ACTIVE)
  passwordChangedAt DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([status, emailVerifiedAt])
}

model Vehicle {
  id             String        @id @default(cuid())
  slug           String        @unique
  make           String
  model          String
  trim           String?
  year           Int
  bodyType       String
  description    String        @db.Text
  price          Decimal?      @db.Decimal(14, 2)
  currency       String        @default("NGN")
  condition      String
  mileage        Int?
  transmission   String?
  fuelType       String?
  engine         String?
  drivetrain     String?
  seats          Int?
  exteriorColour String?
  interiorColour String?
  features       String[]      @default([])
  status         VehicleStatus @default(DRAFT)
  featured       Boolean       @default(false)
  isDemo         Boolean       @default(true)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  images  VehicleImage[]
  options VehicleOption[]
  builds  VehicleBuild[]
  enquiries Enquiry[]
  testDriveRequests TestDriveRequest[]

  @@index([status, publishedAt])
  @@index([make, model])
  @@index([bodyType, year])
  @@index([price, currency])
  @@index([featured, status])
}

model VehicleImage {
  id        String   @id @default(cuid())
  vehicleId String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  imageType String   @default("GALLERY")
  createdAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, sortOrder])
}

model VehicleOption {
  id              String   @id @default(cuid())
  vehicleId       String
  groupKey        String
  optionKey       String
  label           String
  priceDelta      Decimal? @db.Decimal(14, 2)
  available       Boolean  @default(true)
  previewImageUrl String?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, groupKey, optionKey])
  @@index([vehicleId, groupKey, available])
}

model VehicleBuild {
  id              String   @id @default(cuid())
  publicId        String   @unique @default(cuid())
  vehicleId       String
  selectedOptions Json
  previewImageUrl String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  enquiries Enquiry[]

  @@index([vehicleId, createdAt])
}

model Enquiry {
  id           String        @id @default(cuid())
  reference    String        @unique @default(cuid())
  customerName String
  email        String
  phone        String?
  message      String?       @db.Text
  source       String        @default("VEHICLE_DETAIL")
  status       EnquiryStatus @default(NEW)
  vehicleId    String?
  buildId      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  vehicle Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  build   VehicleBuild? @relation(fields: [buildId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([email, createdAt])
}

model TestDriveRequest {
  id            String          @id @default(cuid())
  reference     String          @unique @default(cuid())
  customerName  String
  email         String
  phone         String
  preferredDate DateTime
  preferredTime String
  confirmedDate DateTime?
  confirmedTime String?
  notes         String?         @db.Text
  status        TestDriveStatus @default(REQUESTED)
  vehicleId     String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@index([status, preferredDate])
  @@index([vehicleId, createdAt])
}

model SourcingRequest {
  id                   String               @id @default(cuid())
  reference            String               @unique @default(cuid())
  customerName         String
  email                String
  phone                String?
  requestedMake        String?
  requestedModel       String?
  requestedTrim        String?
  minYear              Int?
  maxYear              Int?
  conditionPreference  String?
  budget               Decimal?             @db.Decimal(14, 2)
  currency             String?
  mileagePreference    String?
  requiredSpecifications String?             @db.Text
  preferredLocation    String?
  notes                String?              @db.Text
  status               SourcingRequestStatus @default(NEW)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([requestedMake, requestedModel])
}

model DealershipSetting {
  id             String   @id @default("default")
  displayName    String   @default("Ritewheel Autos")
  contactPhone   String?
  contactEmail   String?
  whatsappNumber String?
  addressLine    String?
  city           String?
  state          String?
  country        String?
  openingHours   String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([adminUserId, createdAt])
}
